{
	"title": "Большое маленькое приключение",
	"description": "Крош и Ёжик собираются в дорогу, летят на воздушном шаре, выбираются из джунглей и бегут к руинам.",
	"order": 0,
	"max_players": 2,
	"characters": [
		"gameplaymod:krosh_tailed",
		"gameplaymod:yozhik"
	],
	"character_starts": {
		"gameplaymod:yozhik": "@дом_ежика",
		"gameplaymod:krosh_tailed": "@дом_кроша"
	},
	"missions": [
		{
			"id": "morning",
			"title": "С добрым утром",
			"checkpoints": [
				{"at": "@дом_кроша", "character": "gameplaymod:krosh_tailed"},
				{"at": "@дом_ежика", "character": "gameplaymod:yozhik"},
				"@остров"
			],
			"tasks": [
				{
					"id": "k_take",
					"title": "Взять лопату и шкатулку",
					"character": "gameplaymod:krosh_tailed",
					"type": "condition",
					"conditions": [
						{"check": "levelmod:has_item", "item": "#minecraft:shovels"},
						{"check": "levelmod:has_item", "item": "minecraft:paper", "model": "levelmod:shovel_box"}
					]
				},
				{
					"id": "k_water",
					"title": "Принять водные процедуры",
					"character": "gameplaymod:krosh_tailed",
					"type": "condition",
					"conditions": [
						{"check": "gameplaymod:in_water"}
					]
				},
				{
					"id": "k_talk",
					"title": "Поговорить с Ёжиком насчёт шкатулки",
					"character": "gameplaymod:krosh_tailed",
					"after": ["k_take", "k_water"],
					"type": "talk",
					"with": "gameplaymod:yozhik",
					"text": "Ёжик, смотри, что у меня есть! Шкатулка, а в ней лопата. В дороге пригодится!"
				},
				{
					"id": "y_ready",
					"title": "Надеть очки и взять уголь (минимум 5)",
					"character": "gameplaymod:yozhik",
					"type": "condition",
					"conditions": [
						{"check": "gameplaymod:wearing", "item": "gameplaymod:glasses"},
						{"check": "levelmod:has_item", "item": "minecraft:coal", "count": 5}
					]
				},
				{
					"id": "y_tarzan",
					"title": "Раздобыть верёвку",
					"character": "gameplaymod:yozhik",
					"optional": true,
					"type": "get_item",
					"item": "gameplaymod:tarzan_rope",
					"count": 1
				},
				{
					"id": "y_talk",
					"title": "Поговорить с Крошем",
					"character": "gameplaymod:yozhik",
					"after": ["y_ready"],
					"type": "talk",
					"with": "gameplaymod:krosh_tailed"
				}
			]
		},
		{
			"id": "flight",
			"reset_wait": 3,
			"title": "От винта",
			"gear": {"gameplaymod:yozhik": "gameplaymod:glasses"},
			"orders": [
				{"text": "Крош, бери стропу высоты!", "character": "gameplaymod:krosh_tailed", "order": "behaviormod:take_rope", "kind": "lift", "group": "flight"},
				{"text": "Крош, выше!", "character": "gameplaymod:krosh_tailed", "order": "behaviormod:balloon_lift", "steps": 1, "keep": true},
				{"text": "Крош, ниже!", "character": "gameplaymod:krosh_tailed", "order": "behaviormod:balloon_lift", "steps": -1, "keep": true},
				{"text": "Крош, стой!", "character": "gameplaymod:krosh_tailed", "order": "behaviormod:stop"},
				{"text": "Ёжик, бери руль!", "character": "gameplaymod:yozhik", "order": "behaviormod:take_rope", "kind": "helm", "group": "flight"},
				{"text": "Ёжик, вперёд!", "character": "gameplaymod:yozhik", "order": "behaviormod:balloon_helm", "dir": "forward", "keep": true},
				{"text": "Ёжик, назад!", "character": "gameplaymod:yozhik", "order": "behaviormod:balloon_helm", "dir": "back", "keep": true},
				{"text": "Ёжик, левее!", "character": "gameplaymod:yozhik", "order": "behaviormod:balloon_helm", "dir": "left", "keep": true},
				{"text": "Ёжик, правее!", "character": "gameplaymod:yozhik", "order": "behaviormod:balloon_helm", "dir": "right", "keep": true},
				{"text": "Ёжик, стой!", "character": "gameplaymod:yozhik", "order": "behaviormod:stop"},
				{"text": "За мной!", "order": "behaviormod:follow"}
			],
			"checkpoints": ["@остров", "@засада_туземцев"],
			"area": "@шар",
			"tasks": [
				{
					"id": "k_to_balloon",
					"title": "Дойти до воздушного шара",
					"character": "gameplaymod:krosh_tailed",
					"area": "@остров",
					"type": "reach_area",
					"target": "@шар"
				},
				{
					"id": "k_lift",
					"together": false,
					"title": "Залезть в шар и взять стропу «вверх/вниз»",
					"character": "gameplaymod:krosh_tailed",
					"after": ["k_to_balloon"],
					"type": "condition",
					"conditions": [
						{"check": "gameplaymod:holding_rope", "kind": "lift", "group": "flight"}
					]
				},
				{
					"id": "k_jungle",
					"title": "Пересеките джунгли",
					"character": "gameplaymod:krosh_tailed",
					"after": ["k_lift"],
					"type": "condition",
					"conditions": [
						{"check": "levelmod:in_area", "area": "@засада_туземцев"}
					]
				},
				{
					"id": "y_to_balloon",
					"title": "Дойти до воздушного шара",
					"character": "gameplaymod:yozhik",
					"area": "@остров",
					"type": "reach_area",
					"target": "@шар"
				},
				{
					"id": "y_helm",
					"together": false,
					"title": "Взять стропу «вправо/влево, поворот» и залезть в шар",
					"character": "gameplaymod:yozhik",
					"after": ["y_to_balloon"],
					"type": "condition",
					"conditions": [
						{"check": "gameplaymod:holding_rope", "kind": "helm", "group": "flight"}
					]
				},
				{
					"id": "y_jungle",
					"title": "Пересеките джунгли",
					"character": "gameplaymod:yozhik",
					"after": ["y_helm"],
					"type": "condition",
					"conditions": [
						{"check": "levelmod:in_area", "area": "@засада_туземцев"}
					]
				}
			]
		},
		{
			"id": "jungle",
			"guide": "@бездна",
			"reset_wait": 3,
			"title": "Баломут и обормот",
			"gear": {"gameplaymod:yozhik": "gameplaymod:glasses"},
			"checkpoints": ["@засада_туземцев", {"at": "@пещера_старт", "max_y": 0}],
			"tasks": [
				{
					"id": "k_escape",
					"title": "Выбраться из джунглей",
					"area": "@джунгли",
					"character": "gameplaymod:krosh_tailed",
					"type": "condition",
					"conditions": [
						{"check": "levelmod:in_area", "area": "@пещера_старт", "max_y": 0}
					]
				},
				{
					"id": "y_escape",
					"title": "Выбраться из джунглей",
					"area": "@джунгли",
					"character": "gameplaymod:yozhik",
					"type": "condition",
					"conditions": [
						{"check": "levelmod:in_area", "area": "@пещера_старт", "max_y": 0}
					]
				}
			]
		},
		{
			"id": "cave",
			"reset_wait": 5,
			"title": "Верь в меня, Ёжик",
			"gear": {"gameplaymod:yozhik": "gameplaymod:glasses"},
			"checkpoints": ["@пещера_старт", "@бухта"],
			"area": "@лавовое_озеро",
			"tasks": [
				{
					"id": "k_cave",
					"title": "Выбраться из пещеры с лавой",
					"character": "gameplaymod:krosh_tailed",
					"type": "reach_area",
					"target": "@бухта"
				},
				{
					"id": "y_cave",
					"title": "Выбраться из пещеры с лавой",
					"character": "gameplaymod:yozhik",
					"type": "reach_area",
					"target": "@бухта"
				}
			]
		},
		{
			"id": "chase",
			"reset_wait": 3,
			"title": "Погоня",
			"gear": {"gameplaymod:yozhik": "gameplaymod:glasses"},
			"checkpoints": ["@бухта", "@руины"],
			"tasks": [
				{
					"id": "k_ruins",
					"title": "Добежать до руин",
					"character": "gameplaymod:krosh_tailed",
					"type": "reach_area",
					"target": "@руины"
				},
				{
					"id": "y_ruins",
					"title": "Добежать до руин",
					"character": "gameplaymod:yozhik",
					"type": "reach_area",
					"target": "@руины"
				}
			]
		}
	],
	"triggers": [
		{
			"when": "gameplaymod:balloon_stranded:flight",
			"repeat": true,
			"then": {"action": "say", "overlay": true, "text": "Шар сел без топлива: заправьте стропу высоты, иначе через 10 секунд полёт начнётся заново"}
		},
		{
			"when": "gameplaymod:balloon_stranded:flight",
			"repeat": true,
			"delay": 200,
			"unless": "gameplaymod:balloon_lifted:flight",
			"then": [
				{"action": "fail_task", "task": "k_jungle"},
				{"action": "fail_task", "task": "y_jungle"}
			]
		},
		{"when": "task_reset:k_jungle", "repeat": true, "then": {"action": "fail_task", "task": "y_jungle"}},
		{"when": "task_reset:y_jungle", "repeat": true, "then": {"action": "fail_task", "task": "k_jungle"}},
		{"when": "mission_completed:flight", "then": {"action": "gameplaymod:destroy", "group": "flight"}},
		{
			"when": "mission_started:jungle",
			"then": [
				{"action": "gameplaymod:autorun"},
				{"action": "gameplaymod:arrows", "group": "погоня"}
			]
		},
		{"when": "mission_started:cave", "delay": 100, "unless": "mission_reset:cave", "then": {"action": "gameplaymod:lava_wave", "group": "lava1"}},
		{"when": "mission_resumed:cave", "repeat": true, "delay": 200, "unless": "mission_reset:cave", "then": {"action": "gameplaymod:lava_wave", "group": "lava1"}},
		{"when": "task_reset:k_cave", "repeat": true, "then": {"action": "fail_task", "task": "y_cave"}},
		{"when": "task_reset:y_cave", "repeat": true, "then": {"action": "fail_task", "task": "k_cave"}},
		{"when": "gameplaymod:lava_wave_finished:lava1", "repeat": true, "then": {"action": "gameplaymod:lava_wave", "group": "lava2"}},
		{"when": "gameplaymod:lava_wave_finished:lava2", "repeat": true, "then": {"action": "gameplaymod:lava_wave", "group": "lava3"}},
		{"when": "gameplaymod:lava_wave_finished:lava3", "repeat": true, "then": {"action": "gameplaymod:lava_wave", "group": "lava4"}},
		{
			"when": "mission_completed:jungle",
			"then": [
				{"action": "gameplaymod:autorun", "on": false},
				{"action": "gameplaymod:arrows", "group": "погоня", "on": false}
			]
		}
	]
}
